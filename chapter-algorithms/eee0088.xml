<label>Age of child</label>
<path target="cell-7">Under 2 years old</path>
<path target="cell-8">2–5 years old</path>
<path target="cell-10">5 years or older</path>
</cell>
<cell type="action" id="cell-7">
<label>Observe</label>
</cell>
<cell type="decision" id="cell-8">
<label>Fascial defect &gt;2 cm?</label>
<path target="cell-7">No</path>
<path target="cell-9">Yes</path>
</cell>
<cell type="decision" id="cell-9">
<label>Fascial defect decreasing in size?</label>
<path target="cell-7">Yes</path>
<path target="cell-11">No</path>
</cell>
<cell type="decision" id="cell-10">
<label>Fascial defect &gt;2 cm?</label>
<path target="cell-9">No</path>
<path target="cell-11">Yes</path>
</cell>
