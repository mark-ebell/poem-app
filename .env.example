# Copy this file to .env and fill in real values. Never commit .env itself.

# Required: your Anthropic API key, used server-side for all users' draft generations.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a long random string used to sign session cookies. If omitted, a
# new random secret is generated each time the server starts, which logs
# everyone out on restart. Set this to keep sessions alive across restarts.
SESSION_SECRET=

# Optional: port to listen on (default 3000).
PORT=3000

# Optional: a free NCBI API key (https://www.ncbi.nlm.nih.gov/account/settings/) raises
# the PubMed request limit used by the Evidence Summary from 3 to 10 per second.
NCBI_API_KEY=
