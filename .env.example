# Copy this file to .env and fill in real values. Never commit .env itself.

# Required: your Anthropic API key, used server-side for all users' draft generations.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a long random string used to sign session cookies. If omitted, a
# new random secret is generated each time the server starts, which logs
# everyone out on restart. Set this to keep sessions alive across restarts.
SESSION_SECRET=

# Optional: port to listen on (default 3000).
PORT=3000

# ---------- Reader (public) accounts ----------
# The address of this site, used in the links in reader emails, e.g. https://inforetriever.org
APP_URL=

# Reader emails (confirm address, reset password) are sent through Resend (https://resend.com).
# EMAIL_FROM must use a domain verified in Resend, e.g. InfoRetriever <no-reply@inforetriever.org>.
# Without RESEND_API_KEY the emails are written to the server log instead (for local testing).
RESEND_API_KEY=
EMAIL_FROM=

# Cloudflare Turnstile, the "are you human" check on the sign-up form
# (https://dash.cloudflare.com > Turnstile). Without both keys the check is skipped.
# The site key is public; the secret key is private (never commit it).
# Optional: TURNSTILE_HOSTNAMES, comma-separated, if the site answers on more than APP_URL's hostname.
TURNSTILE_SITE_KEY=0x4AAAAAAFi0QopVBID1B8t7
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=

# Optional: a free NCBI API key (https://www.ncbi.nlm.nih.gov/account/settings/) raises
# the PubMed request limit used by the Evidence Summary from 3 to 10 per second.
NCBI_API_KEY=
